# Registry dimensions are checked by scripts/tests/test_synthetic_graph_registry.py.
function(skippy_contract_case family arch layers width mtp mode)
    set(contract_dir "${SKIPPY_MODEL_FIXTURE_DIR}/contract-${family}")
    file(MAKE_DIRECTORY "${contract_dir}")
    add_test(NAME skippy_generate_contract_${family} COMMAND skippy-model-fixture-generator
        --arch ${arch} --graph-contract ${layers} ${width} --contract-mtp ${mtp} --out "${contract_dir}")
    set_tests_properties(skippy_generate_contract_${family} PROPERTIES FIXTURES_SETUP contract-${family})
    add_test(NAME skippy_graph_contract_${family} COMMAND skippy-graph-contract-models
        "${contract_dir}/graph-contract.gguf" ${mode})
    set_tests_properties(skippy_graph_contract_${family} PROPERTIES FIXTURES_REQUIRED contract-${family} TIMEOUT 900)
endfunction()

